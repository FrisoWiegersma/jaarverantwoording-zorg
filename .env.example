# Required for chat and OCR of scanned PDF pages. Keep the real key in .env.
GEMINI_API_KEY=

# Address people use to open the app; Excel source hyperlinks use this origin.
APP_ORIGIN=http://localhost:3210

# Optional OCR model override (the application default). The chat model is picked in the app.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Swing Open Data Service keys (free, one per organisation). Without a key that site is not connected.
# Prognosemodel Zorg en Welzijn: request at https://prognosemodelzw.nl/contact
# PMZW_API_KEY=
# Waarstaatjegemeente: request at https://www.waarstaatjegemeente.nl/contact
# WSJG_API_KEY=
