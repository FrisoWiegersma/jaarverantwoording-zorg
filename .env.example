# AI providers: set at least one key; each adds its models to the picker. Keep the real keys in .env.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# Optional: other OpenAI model ids than the default gpt-6.1-sol,gpt-6.1-terra,gpt-6-astra, or another endpoint.
# OPENAI_MODELS=
# OPENAI_BASE_URL=
# Anything else that speaks the OpenAI API (Ollama, OpenRouter, Mistral, Groq, vLLM, LM Studio). The models must
# support tool calls. From the Docker container, the host is host.docker.internal.
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODELS=qwen3:32b
# OPENAI_COMPATIBLE_NAME=Ollama
# Scanned PDF pages are read by the first of Gemini (3.5 Flash Lite), Claude (Haiku 5.5) or OpenAI (gpt-6.1-terra) that
# has a key. Another model, for example a vision model on the compatible server: OCR_MODEL=compatible:qwen2.5vl:7b
# OCR_MODEL=

# Address people use to open the app; Excel source hyperlinks use this origin.
APP_ORIGIN=http://localhost:3210

# Who people are. builtin (the default): the app's own email-and-password login, accounts in the web-data volume.
# cloudflare: Cloudflare Access signs people in and the app trusts its cf-access-authenticated-user-email header;
# only use it when Cloudflare Access is really in front, or anyone can claim any email.
AUTH_MODE=builtin
# Optional, builtin mode: signs the session cookies. Without it the app makes one on first start and keeps it with
# the accounts; set your own (`openssl rand -hex 32`) to keep it with your other secrets.
# BETTER_AUTH_SECRET=
# Optional, builtin mode: who may create an account. Addresses or @domains, comma-separated; empty lets anyone sign up.
# Addresses are not verified (no mail is sent), so on a public address also close sign-up once everyone has an account.
# AUTH_ALLOWED_EMAILS=@example.nl,someone@example.com
# AUTH_ALLOW_SIGNUP=false

# Optional OCR model override (the application default). The chat model is picked in the app.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Swing Open Data Service keys (free, one per organisation). Without a key that site is not connected.
# Prognosemodel Zorg en Welzijn: request at https://prognosemodelzw.nl/contact
# PMZW_API_KEY=
# Waarstaatjegemeente: request at https://www.waarstaatjegemeente.nl/contact
# WSJG_API_KEY=
